<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NeoSyncHelper</AssemblyName>
    <RootNamespace>NeoSync.Service</RootNamespace>
    <Version>0.9.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting"               Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoSync.Core\NeoSync.Core.csproj" />
  </ItemGroup>

  <!-- Driver files needed for BD04 mode switch and BD01 staging -->
  <ItemGroup>
    <Content Include="..\installer\driver\neosync_bd04.inf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>driver\neosync_bd04.inf</Link>
    </Content>
    <Content Include="..\installer\driver\neosync_bd04.cat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>driver\neosync_bd04.cat</Link>
    </Content>
    <Content Include="..\installer\driver\neosync_bd01.inf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>driver\neosync_bd01.inf</Link>
    </Content>
    <Content Include="..\installer\driver\neosync_bd01.cat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>driver\neosync_bd01.cat</Link>
    </Content>
    <Content Include="..\installer\driver\neosync.cer">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>driver\neosync.cer</Link>
    </Content>
  </ItemGroup>

</Project>
